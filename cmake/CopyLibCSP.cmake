# CopyLibCSP.cmake
# Variables expected: CONFIG, CSerialPort_DIR, DEST
if(NOT DEFINED CONFIG)
  set(CONFIG "Debug")
endif()
if(NOT DEFINED CSerialPort_DIR)
  message(STATUS "CSerialPort_DIR not defined; skipping libcserialport copy")
  return()
endif()
if(NOT DEFINED DEST)
  message(STATUS "DEST not defined; skipping libcserialport copy")
  return()
endif()
if(CONFIG STREQUAL "Debug")
  set(INPUT "${CSerialPort_DIR}/build_vs22/bin/Debug/libcserialport.dll")
else()
  set(INPUT "${CSerialPort_DIR}/build_vs22/bin/Release/libcserialport.dll")
endif()
if(EXISTS "${INPUT}")
  file(COPY "${INPUT}" DESTINATION "${DEST}")
  message(STATUS "Copied libcserialport from ${INPUT} to ${DEST}")
else()
  message(STATUS "libcserialport not found at ${INPUT}; skipping copy")
endif()
